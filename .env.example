TAVILY_API_KEY=tvly-...
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Run defaults (optional). The web UI's Settings page writes these; CLI flags still win.
# YTDL_OUT=songs
# YTDL_WORKERS=4
# YTDL_BITRATE=320
# YTDL_NO_PLAYLIST=0
# YTDL_NO_ALBUM_LOOKUP=0
# YTDL_COOKIES_FROM_BROWSER=
# YTDL_YES=0
# YTDL_LOG_DIR=logs
# YTDL_PREVIEW_LINKS=1   # web UI: a pasted Spotify link opens its preview

# Plex playlist sync (optional): see README "Plex"
PLEX_URL=http://127.0.0.1:32400
PLEX_TOKEN=
# YTDL_NO_PLEX=0
